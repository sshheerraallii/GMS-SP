+
+        // Admin — everything except user management.
         $admin = Role::firstOrCreate(['name' => 'Admin']);
-        $admin->givePermissionTo(
+        $admin->syncPermissions(
             Permission::where('name', '!=', 'users.manage')->get()
         );
 
-        $moderator = Role::firstOrCreate(['name' => 'Moderator']);
